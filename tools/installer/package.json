{
  "name": "@forge-it/installer",
  "version": "0.1.0",
  "description": "Install Forge It agents into a selected coding harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forge-it": "./dist/cli.js"
  },
  "files": ["dist", "assets", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@forge-it/architecture": "0.1.0",
    "@forge-it/design": "0.1.0",
    "@forge-it/prototype": "0.1.0",
    "@forge-it/pipeline": "0.1.0",
    "@forge-it/quality": "0.1.0",
    "@forge-it/testing": "0.1.0",
    "@forge-it/merge": "0.1.0",
    "@forge-it/specs": "0.1.0",
    "@forge-it/tracker": "0.1.0",
    "commander": "^14.0.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
